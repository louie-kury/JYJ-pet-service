# .env로 복사한 뒤 두 비밀번호를 로컬 개발용 값으로 변경하세요.
MYSQL_ROOT_PASSWORD=REPLACE_WITH_LOCAL_ROOT_PASSWORD
MYSQL_PASSWORD=REPLACE_WITH_LOCAL_SERVICE_PASSWORD

# 호스트에서 Spring Boot를 실행할 때 사용할 환경변수입니다.
# Compose가 읽은 .env 값은 호스트 프로세스에 자동으로 전달되지 않습니다.
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/louie_kury_pet_dev
MYSQL_USERNAME=pet_service
